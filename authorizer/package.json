{
    "name": "studup-api-authorizer",
    "version": "1.0.0",
    "private": true,
    "dependencies": {
        "jsonwebtoken": "^9.0.2",
        "@aws-sdk/client-secrets-manager": "3.1156.0"
    },
    "scripts": {
        "lint": "node --check index.mjs && node --check token-policy.mjs",
